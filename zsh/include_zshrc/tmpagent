# tmpagent: tmpgrok / tmpcursor / tmpclaude — mktemp -d, cd, run grok, cursor-agent, or claude (args forwarded).
# Shell stays in the tempdir after the CLI exits. `s tg` / `s tc` / `s tcc` work: seatbelt
# expands aliases and re-invokes these functions inside sandbox-exec.
_tmp_cli() {
  local prefix="$1"
  shift
  local dir
  dir="$(mktemp -d "${TMPDIR:-/tmp}/${prefix}.XXXXXX")" || return
  cd "$dir" || return
  "$@"
}
tmpgrok() { _tmp_cli tmpgrok grok "$@"; }
tmpcursor() { _tmp_cli tmpcursor cursor-agent "$@"; }
tmpclaude() { _tmp_cli tmpclaude claude "$@"; }
